{
    "compilerOptions": {
    "target": "es2020",
      "lib": [
        "dom",
        "esnext"
      ],
      "allowJs": true,
      "skipLibCheck": true,
      "esModuleInterop": true,
      "allowSyntheticDefaultImports": true,
      "strict": true,
      "forceConsistentCasingInFileNames": true,
      "noFallthroughCasesInSwitch": true,
      "module": "node16",
      "moduleResolution": "node16",
      "resolveJsonModule": true,
      "isolatedModules": true,
      "outDir": "dist/",
      "noEmit": false,
      "rootDir": "src"
    },
    "include": ["src/**/*.ts"]
}
